# このツールは envutil.get_secret 経由でリポジトリ直下（jp_stock_alert/の一つ上）の .env のみを読む。
# jp_stock_alert/.env を作っても読み込まれないため、必ずリポジトリ直下の .env に以下を追記すること。
# これはそのフォーマットのサンプル（コピー先はリポジトリ直下）。

# Discord Webhook URL（株通知用・リポジトリ直下の.envに既にある場合は追記不要、そのまま再利用される）
DISCORD_WEBHOOK_URL_KABU=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# J-Quants API（任意・第一候補データソース）
# 未設定の場合は自動的にyfinanceフォールバックを使う。
# 取得手順: https://jpx-jquants.com/ でアカウント登録 → メールアドレス/パスワードでリフレッシュトークンを取得
JQUANTS_EMAIL=
JQUANTS_PASSWORD=
